# ───────── 북모먼트 배포용 환경변수 ─────────
# 이 파일을 .env.production 으로 복사한 뒤 값을 채워 주세요.  (cp .env.production.example .env.production)
# .env.production 은 git 에 올라가지 않아요. 비밀번호 · 키가 들어 있으니 절대 공유하지 마세요.

# DB 비밀번호 — 영문 · 숫자만 (예: openssl rand -hex 24 로 만든 값)
POSTGRES_PASSWORD=여기에-긴-무작위-값

# 로그인 토큰 서명 키 — 32자 이상 무작위 (예: openssl rand -hex 48)
JWT_SECRET=여기에-더-긴-무작위-값

# 웹 화면 주소 = Vercel 주소 (https 포함, 끝에 / 없이). 여러 개면 쉼표로 구분
CLIENT_ORIGIN=https://bookmoment.vercel.app

# 사용자는 https(Vercel)로 접속하니 true. 서버 주소로 http 직접 테스트할 때만 false
COOKIE_SECURE=true

APP_TIMEZONE=Asia/Seoul
JWT_REMEMBER_DAYS=30
MAX_UPLOAD_MB=5

# 책 검색(표지 자동 채우기) — 선택. 국립중앙도서관 · 카카오 · 네이버 키를 넣으면 한국 도서가 잘 나와요
# 국립중앙도서관 인증키: https://www.nl.go.kr → Open API → 인증키 신청/관리 (쪽수까지 자동으로 채워 줘요)
NLK_API_KEY=
KAKAO_REST_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_BOOKS_API_KEY=

# ───────── API 서버가 열릴 곳 ─────────
# API_PORT : Vercel 이 요청을 넘겨줄 포트 (frontend/vercel.json 의 주소와 맞춰 주세요)
# APP_BIND : 0.0.0.0 = 바깥에서 접속 가능. 앞에 Caddy · Cloudflare Tunnel 을 두면 127.0.0.1
API_PORT=8080
APP_BIND=0.0.0.0

# 사용자 실제 IP 를 알아내기 위해 믿을 프록시 개수 (로그인 횟수 제한에 쓰여요)
#   Vercel → API 바로 연결: 1 / Vercel → Caddy 또는 Cloudflare Tunnel → API: 2
TRUST_PROXY=1

# ───────── DB 이름 · 사용자 (선택) ─────────
# 비워 두면 둘 다 bookmoment. DB 비밀번호는 맨 위 POSTGRES_PASSWORD 하나만 써요.
# ※ 처음 실행한 뒤에 바꾸면 기존 DB 에는 적용되지 않아요(DB 볼륨을 새로 만들 때만 적용).
RDB_DATABASE=
RDB_USERNAME=

# 외부 DB(예: AWS RDS)를 쓸 때만 전체 주소를 넣어요. 비워 두면 함께 뜨는 db 컨테이너를 써요.
# 예) postgresql://사용자:비밀번호@호스트:5432/DB이름?schema=public
RDB_URL=