# ───────── 북모먼트 배포용 환경변수 ─────────
# 이 파일을 .env.production 으로 복사한 뒤 값을 채워 주세요.  (cp .env.production.example .env.production)
# .env.production 은 git 에 올라가지 않아요. 비밀번호 · 키가 들어 있으니 절대 공유하지 마세요.

# DB 비밀번호 — 영문 · 숫자만 (예: openssl rand -hex 24 로 만든 값)
POSTGRES_PASSWORD=여기에-긴-무작위-값

# 로그인 토큰 서명 키 — 32자 이상 무작위 (예: openssl rand -hex 48)
JWT_SECRET=여기에-더-긴-무작위-값

# 서비스 주소 (https 포함, 끝에 / 없이)
CLIENT_ORIGIN=https://bookmoment.example.com

# https 로 서비스하면 true (로그인 쿠키에 Secure 를 붙임). http 로만 테스트할 때는 false
COOKIE_SECURE=true

APP_TIMEZONE=Asia/Seoul
JWT_REMEMBER_DAYS=30
MAX_UPLOAD_MB=5

# 책 검색(표지 자동 채우기) — 선택. 카카오 또는 네이버 키를 넣으면 한국 도서가 잘 나와요
KAKAO_REST_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_BOOKS_API_KEY=

# 앱이 열릴 주소/포트 — 기본은 서버 내부(127.0.0.1)만. Caddy/Nginx 없이 바로 열려면 0.0.0.0
APP_BIND=127.0.0.1
APP_PORT=4000
