# 북모먼트 API 서버 전용 이미지 — 웹 화면(frontend)은 Vercel 에 따로 배포한다.
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# · 빌드 중 apt-get 을 쓰지 않는다 (http(80) 이 막힌 학교 · 회사망에서도 빌드되도록)
# · Prisma 가 쓰는 OpenSSL 라이브러리는 같은 Debian(bookworm) 기반 full 이미지에서 복사해 온다
# · 웹 화면까지 한 서버에서 제공하려면 이 파일 대신 Dockerfile 을 쓰면 된다

# ── 1단계: 서버 패키지 설치 + Prisma 클라이언트 생성 ──
FROM node:22-bookworm AS build
WORKDIR /app
# workspaces 구조라 루트 · backend · frontend 의 package.json 이 모두 있어야 npm ci 가 동작한다
COPY package.json package-lock.json ./
COPY backend/package.json backend/
COPY frontend/package.json frontend/
# -w backend : 백엔드 패키지만 설치 (React · Vite 같은 웹 화면 패키지는 설치하지 않음)
RUN npm ci --omit=dev -w backend
COPY backend backend
RUN cd backend && npx prisma generate \
 && mkdir -p /ssl \
 && cp /usr/lib/$(uname -m)-linux-gnu/libssl.so.3 /usr/lib/$(uname -m)-linux-gnu/libcrypto.so.3 /ssl/

# ── 2단계: 실행 (작은 slim 이미지 + OpenSSL 라이브러리 두 개만) ──
FROM node:22-bookworm-slim
ENV NODE_ENV=production
ENV PORT=8080
COPY --from=build /ssl/ /tmp/ssl/
RUN cp /tmp/ssl/* /usr/lib/$(uname -m)-linux-gnu/ && rm -rf /tmp/ssl && ldconfig
WORKDIR /app
COPY --from=build --chown=node:node /app /app
RUN mkdir -p /app/backend/uploads && chown -R node:node /app/backend/uploads
USER node
WORKDIR /app/backend
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD node -e "fetch('http://localhost:'+(process.env.PORT||8080)+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
# 시작할 때마다 DB 마이그레이션을 먼저 적용하고 서버를 켠다 (서버 시작 파일은 src/server.js)
CMD ["sh", "-c", "npx prisma migrate deploy && node src/server.js"]
