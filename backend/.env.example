# ───────── 북모먼트 백엔드 환경변수 ─────────
# 이 파일을 .env 로 복사한 뒤 값을 채워 주세요.  (cp .env.example .env)

NODE_ENV=development
PORT=4000

# docker compose 로 띄운 PostgreSQL (docker-compose.yml 참고)
DATABASE_URL="postgresql://bookmoment:bookmoment_local_only@localhost:5432/bookmoment?schema=public"

# 32자 이상의 무작위 문자열. 예) node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# '로그인 상태 유지' 선택 시 토큰 유지 일수
JWT_REMEMBER_DAYS=30

# 프론트엔드 주소 (CORS 허용 Origin, 쉼표로 여러 개 가능)
CLIENT_ORIGIN=http://localhost:5173

# 업로드 파일 저장 폴더 / 최대 용량(MB)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# '오늘', '이번 달' 계산 기준 시간대
APP_TIMEZONE=Asia/Seoul

# ───────── 책 검색(표지 · 정보 자동 채우기) — 선택 ─────────
# 아래 중 설정된 것부터 사용하고, 없으면 Google Books → Open Library(키 없음, 영문 도서 위주)로 검색해요.
# 한국 도서를 제대로 찾으려면 국립중앙도서관 · 카카오 · 네이버 중 하나는 넣는 걸 추천해요.
# 국립중앙도서관(ISBN 서지정보, 쪽수까지 채워 줌): https://www.nl.go.kr → Open API → 인증키 신청/관리
NLK_API_KEY=
# 카카오: https://developers.kakao.com → 내 애플리케이션 → 앱 키의 'REST API 키'
KAKAO_REST_API_KEY=
# 네이버: https://developers.naver.com → 애플리케이션 등록(검색 API)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Google Books (선택, 요청 제한 완화)
GOOGLE_BOOKS_API_KEY=

# https 로 서비스할 때 true (쿠키 Secure 플래그)
COOKIE_SECURE=false
