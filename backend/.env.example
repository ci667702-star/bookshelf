# ───────── 북모먼트 백엔드 환경변수 ─────────
# 이 파일을 .env 로 복사한 뒤 값을 채워 주세요.  (cp .env.example .env)

NODE_ENV=development
PORT=4000

# docker compose 로 띄운 PostgreSQL (docker-compose.yml 참고)
DATABASE_URL="postgresql://bookmoment:bookmoment_local_only@localhost:5433/bookmoment?schema=public"

# 32자 이상의 무작위 문자열. 예) node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# '로그인 상태 유지' 선택 시 토큰 유지 일수
JWT_REMEMBER_DAYS=30

# 프론트엔드 주소 (CORS 허용 Origin, 쉼표로 여러 개 가능)
CLIENT_ORIGIN=http://localhost:5173

# 업로드 파일 저장 폴더 / 최대 용량(MB)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# '오늘', '이번 달' 계산 기준 시간대
APP_TIMEZONE=Asia/Seoul

# https 로 서비스할 때 true (쿠키 Secure 플래그)
COOKIE_SECURE=false
