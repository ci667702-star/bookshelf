{
  "name": "북모먼트 BookMoment",
  "short_name": "북모먼트",
  "description": "오늘 읽은 한 페이지가 나만의 책장이 됩니다. 읽은 책을 기록하고 친구와 나누는 독서 SNS.",
  "lang": "ko",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#FFF9F2",
  "theme_color": "#FFF9F2",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "책 등록", "url": "/books/new", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "독서 달력", "url": "/calendar", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
